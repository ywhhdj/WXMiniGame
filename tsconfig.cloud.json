{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["ES2017"],
    "types": []
  },
  "include": ["cloudfunctions/**/*.ts"],
  "exclude": ["node_modules"]
}
