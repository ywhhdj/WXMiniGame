<view class="silder-wrap">
  <slot name="left"></slot>
  <slider
      class="silder-bar"
      min="{{min}}"
      max="{{max}}"
      step="{{step}}"
      value="{{value}}"
      disabled="{{disabled}}"
      show-value="{{showValue}}"
      activeColor="rgba(255,255,255,0.7)"
      block-color="#79d9ff"
      bindchange="onChange"
      bindchanging="onChanging"
      block-size="24"
    />
  <slot name="right"></slot>
</view>
