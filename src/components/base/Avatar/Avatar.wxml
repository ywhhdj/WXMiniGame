<view class="avatar-portrait {{imageLoaded ? 'avatar-portrait--loaded' : ''}}"
  style="width: {{size}}rpx; height: {{size}}rpx;"
>
  <view class="avatar-portrait-placeholder" wx:if="{{!imageLoaded}}"></view>
  <!-- 加载失败占位 -->
  <view class="avatar-portrait-error" wx:if="{{imageLoaded && imageError}}">
    <text class="avatar-portrait-error-icon">?</text>
  </view>
  <image wx:else
    class="avatar-portrait-img {{imageLoaded ? 'avatar-portrait-img--visible' : ''}}"
    src="{{src}}"
    mode="aspectFill"
    bindload="onImageLoad"
    binderror="onImageError"
  />
  <view class="avatar-portrait-ring"></view>
</view>