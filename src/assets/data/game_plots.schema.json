{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "object",
      "patternProperties": {
        "node_\\d+$": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "text": {
              "type": "array",
              "items": { "type": "string" }
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "number" },
                  "text": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "attrs": {
                    "type": "object",
                    "properties": {
                      "reward": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": ["potential", "root", "wit", "chance", "goodness"]
                            },
                            "value": { "type": "number" }
                          },
                          "required": ["type", "value"]
                        }
                      },
                      "punish":{
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": ["potential", "root", "wit", "chance", "goodness"]
                            },
                            "value": { "type": "number" }
                          },
                          "required": ["type", "value"]
                        }
                      }
                    }
                  },
                  "traits": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["至尊骨", "吾辈楷模", "头铁", "后天木灵"]
                    }
                  }
                },
                "required": ["id", "text"]
              }
            },
            "attrs": {
              "type": "object",
              "properties": {
                "reward": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["potential", "root", "wit", "chance", "goodness"]
                      },
                      "value": { "type": "number" }
                    },
                    "required": ["type", "value"]
                  }
                },
                "punish": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["potential", "root", "wit", "chance", "goodness"]
                      },
                      "value": { "type": "number" }
                    },
                    "required": ["type", "value"]
                  }
                }
              }
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["至尊骨", "吾辈楷模", "头铁", "后天木灵"]
              }
            },
            "isLevelUpNode":{
              "type": "boolean"
            },
            "next": { "type": "string" }
          },
          "required": ["id", "text", "next"]
        }
      }
    }
  },
  "required": ["nodes"]
}
