# 复制为 .env.local 后由 `npm run inject:env` 注入 miniprogram/config/env.ts
# .env.local 已被 .gitignore 排除，禁止提交到仓库
# 云环境 ID 与 fileID 不是密钥，但生产/测试环境必须隔离管理

CLOUD_ENV=cloud1-xxxxxxxxxxxxxxxx
AUDIO_FILE_ID_1=cloud://cloud1-xxxxxxxx.xxxx-cloud1-xxxxxxxx-xxxxxxxx/夏·烟火.mp3
AUDIO_FILE_ID_2=cloud://cloud1-xxxxxxxx.xxxx-cloud1-xxxxxxxx-xxxxxxxx/穿越时空的思念钢琴版.m4a

# 可选：只允许指定 appid 调用云函数（逗号分隔）；留空表示不校验
APPID_ALLOWLIST=
