{
  "name": "wx-mini-game",
  "version": "1.0.0",
  "private": true,
  "description": "微信小程序修仙文字游戏",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:shared:check": "node scripts/sync-shared.mjs --check",
    "inject:env": "node scripts/inject-env.mjs",
    "env:check": "node scripts/inject-env.mjs --check",
    "env:restore": "node scripts/inject-env.mjs --restore",
    "validate:plots": "node scripts/validate-plots.mjs",
    "build:shared": "node scripts/build-shared.mjs",
    "test": "node scripts/selftest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.cloud.json",
    "build:cloud": "bash scripts/build-cloud.sh",
    "deploy:cloud": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "miniprogram-api-typings": "^2.8.3",
    "typescript": "^5.4.5"
  }
}
